<Window x:Class="MinMaxApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вариант №11" Height="350" Width="450" ResizeMode="NoResize">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" TextWrapping="Wrap" Margin="0,0,0,15" FontWeight="Bold"
                   Text="Вычислить максимум или минимум из трёх вещественных чисел."/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Число 1:" VerticalAlignment="Center" Margin="0,5,10,5"/>
        <TextBox x:Name="TxtNum1" Grid.Row="1" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Число 2:" VerticalAlignment="Center" Margin="0,5,10,5"/>
        <TextBox x:Name="TxtNum2" Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,5,0,5"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Число 3:" VerticalAlignment="Center" Margin="0,5,10,5"/>
        <TextBox x:Name="TxtNum3" Grid.Row="3" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,5,0,5"/>

        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,15,0,15">
            <RadioButton x:Name="RbMax" Content="Максимум" IsChecked="True" Margin="0,0,15,0"/>
            <RadioButton x:Name="RbMin" Content="Минимум"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button Content="Вычислить" Width="100" Height="30" Click="BtnCalculate_Click"/>
            <TextBlock x:Name="TxtResult" Text="Результат =" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>